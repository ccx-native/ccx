# Project-local Claude Code state, if `claude` is ever run in this directory
# (settings.local.json, permission allowlists, project-local memory, etc.).
# The actual user memory lives under ~/.claude/, outside this repo.
.claude/

# Local-only test artifacts
*.transcript.json
*.log

