{
  "name": "ccx-native",
  "version": "0.1.0",
  "description": "Control and monitor native Claude Code and Codex sessions from the CLI, Python or RPC, on your own subscriptions.",
  "author": "Fernando <ccx@delega.ai>",
  "license": "MIT",
  "bin": {
    "ccx": "bin/ccx"
  },
  "files": [
    "bin/ccx",
    "ccx.py",
    "ccx/**/*.py",
    "!ccx/codex/schema.py",
    "skills/",
    "README.md",
    "LICENSE",
    "pyproject.toml"
  ],
  "scripts": {
    "test": "python3 -m compileall -q ccx ccx.py"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "terminal",
    "pty",
    "automation"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccx-native/ccx.git"
  },
  "bugs": {
    "url": "https://github.com/ccx-native/ccx/issues"
  },
  "homepage": "https://github.com/ccx-native/ccx#readme"
}
